<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <!--
    Forces the process ANSI code page to UTF-8 (Windows 10 1903+), so
    std::filesystem::path::string() stops throwing on non-Latin mod filenames
    (Cyrillic / CJK / accented) that Skyrim mods routinely ship. Same reason the
    Scene Editor carries this manifest — the Data-folder scan walks user mods.
  -->
  <application>
    <windowsSettings>
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
    </windowsSettings>
  </application>
</assembly>
