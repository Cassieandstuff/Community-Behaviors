{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "release",
      "displayName": "Community Behaviors — Release (x64-windows-static)",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-windows-static",
        "VCPKG_OVERLAY_PORTS": "${sourceDir}/cmake/ports",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded$<$<CONFIG:Debug>:Debug>"
      }
    },
    {
      "name": "debug",
      "inherits": "release",
      "displayName": "Community Behaviors — Debug (x64-windows-static)",
      "binaryDir": "${sourceDir}/build/debug"
    },
    {
      "name": "resolve",
      "inherits": "release",
      "displayName": "Community Behaviors — cb-resolve only (library export)",
      "binaryDir": "${sourceDir}/build/resolve",
      "cacheVariables": { "CB_RESOLVE_ONLY": "ON" }
    }
  ],
  "buildPresets": [
    { "name": "release", "configurePreset": "release", "configuration": "RelWithDebInfo" },
    { "name": "debug",   "configurePreset": "debug",   "configuration": "Debug" }
  ]
}
