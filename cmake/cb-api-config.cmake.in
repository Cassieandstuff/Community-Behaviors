@PACKAGE_INIT@

# cb-api links ryml transitively (the engine), so a consumer's find_package(cb-api)
# must be able to find ryml too. It's impl-only in the public headers but a real link dependency.
include(CMakeFindDependencyMacro)
find_dependency(ryml)
find_dependency(lz4)

include("${CMAKE_CURRENT_LIST_DIR}/cb-api-targets.cmake")

# The class-schema tree shipped beside this config (see cb_install_schema in cmake/Schema.cmake).
# Feed CB_API_SCHEMA_DIR to CB::engine::schema::SchemaRegistry::LoadDir(...) so the merge classifier is
# byte-for-byte the one the compiler used for THIS package version — don't hardcode the path.
# CB_API_SCHEMA_VERSION is the schema contract version this package was built with — the same
# CB_SCHEMA_VERSION its shipped tree's SCHEMA.yaml stamp carries — so a tool can display / gate on it.
set_and_check(CB_API_SCHEMA_DIR "@PACKAGE_CB_API_SCHEMA_INSTALL_DIR@")
set(CB_API_SCHEMA_VERSION "@CB_SCHEMA_VERSION@")

# Config mapping: this package may ship a single build config (e.g. a manual cmake --install of
# RelWithDebInfo), but a multi-config consumer (VS: Debug/Release/RelWithDebInfo/MinSizeRel) needs an
# imported location for EVERY config it enumerates at generate time. Map any config lacking its own
# location onto a shipped one (RELEASE if present, else the first). MAP_IMPORTED_CONFIG_<c> is consulted
# ONLY when config <c> has no IMPORTED_LOCATION, so setting all four is safe — a config that WAS shipped
# (e.g. Debug + Release under vcpkg) keeps its own location and ignores the map.
get_property(_cb_cfgs TARGET cb::engine PROPERTY IMPORTED_CONFIGURATIONS)
if("RELEASE" IN_LIST _cb_cfgs)
    set(_cb_fallback RELEASE)
elseif(_cb_cfgs)
    list(GET _cb_cfgs 0 _cb_fallback)
endif()
if(_cb_fallback)
    foreach(_cb_t cb::engine)
        foreach(_cb_c DEBUG RELEASE RELWITHDEBINFO MINSIZEREL)
            set_property(TARGET ${_cb_t} PROPERTY MAP_IMPORTED_CONFIG_${_cb_c} "${_cb_fallback}")
        endforeach()
    endforeach()
endif()

check_required_components(cb-api)
