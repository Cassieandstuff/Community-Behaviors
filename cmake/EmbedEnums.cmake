# EmbedEnums.cmake — generate GeneratedEnums.cpp (compiled-in enum tables) from every `kind: enum`
# descriptor under the schema tree, wherever it sits (folders carry no meaning). The yaml is the single
# hand-edited source; this bakes it into the DLL at build time so HavokEnums.h holds no hardcoded tables.
#
# Invoked as a script:  cmake -DSCHEMA_DIR=<dir> -DOUT_CPP=<file> -P EmbedEnums.cmake
#
# The enum yaml is a small, fixed shape (kind:/name:/flags:/items: with `- { name: X , value: N }`),
# so a line-oriented regex parse here is sufficient and keeps codegen tool-free (no build-time
# Python/CLI dependency, no dependency cycle into havok-framing).

if(NOT DEFINED SCHEMA_DIR OR NOT DEFINED OUT_CPP)
    message(FATAL_ERROR "EmbedEnums.cmake: SCHEMA_DIR and OUT_CPP are required")
endif()

file(GLOB_RECURSE _all "${SCHEMA_DIR}/*.yaml")
set(_files "")
foreach(_y IN LISTS _all)
    file(STRINGS "${_y}" _kind REGEX "^kind:[ \t]*enum[ \t\r]*(#.*)?$" LIMIT_COUNT 1)
    if(_kind)
        list(APPEND _files "${_y}")
    endif()
endforeach()
# Deterministic output order, by enum type name (the file's stem), independent of where the file sits.
set(_keyed "")
foreach(_f IN LISTS _files)
    get_filename_component(_stem "${_f}" NAME_WE)
    list(APPEND _keyed "${_stem}|${_f}")
endforeach()
list(SORT _keyed)
set(_files "")
foreach(_k IN LISTS _keyed)
    string(REGEX REPLACE "^[^|]*\\|" "" _f "${_k}")
    list(APPEND _files "${_f}")
endforeach()

set(_arrays "")
set(_registry "")
set(_n 0)

foreach(_f IN LISTS _files)
    file(READ "${_f}" _txt)

    # enum type name — the top-level `name:` (item `name:`s are all preceded by `{`)
    string(REGEX MATCH "name:[ ]*([A-Za-z0-9_]+)" _ "${_txt}")
    set(_name "${CMAKE_MATCH_1}")
    if(NOT _name)
        message(FATAL_ERROR "EmbedEnums.cmake: no 'name:' in ${_f}")
    endif()

    string(REGEX MATCH "flags:[ ]*(true|false)" _ "${_txt}")
    set(_flags "${CMAKE_MATCH_1}")
    if(NOT _flags)
        set(_flags "false")
    endif()

    # each item: `{ name: IDENT , value: -?N }`
    string(REGEX MATCHALL "{[ ]*name:[ ]*[A-Za-z0-9_]+[ ]*,[ ]*value:[ ]*-?[0-9]+[ ]*}" _items "${_txt}")
    set(_arr "")
    set(_count 0)
    foreach(_it IN LISTS _items)
        string(REGEX MATCH "name:[ ]*([A-Za-z0-9_]+)[ ]*,[ ]*value:[ ]*(-?[0-9]+)" _ "${_it}")
        string(APPEND _arr "    {\"${CMAKE_MATCH_1}\", ${CMAKE_MATCH_2}},\n")
        math(EXPR _count "${_count}+1")
    endforeach()

    string(APPEND _arrays "static const GenItem A${_n}[] = {\n${_arr}};\n")
    string(APPEND _registry "    {\"${_name}\", ${_flags}, A${_n}, ${_count}},\n")
    math(EXPR _n "${_n}+1")
endforeach()

set(_body
"// GENERATED by cmake/EmbedEnums.cmake from the schema's kind: enum descriptors -- DO NOT EDIT.
// The yaml data tree is the single source; this bakes it into the binary. Regenerated at build
// whenever an enum yaml changes. Backs havok::model::enums::EnumTable (see HavokEnums.h).
#include <interface/HavokEnums.h>
#include <string>
#include <unordered_map>

namespace CB::engine::common::enums {
namespace {
struct GenItem { const char* name; long value; };
struct GenEnum { const char* name; bool isFlags; const GenItem* items; int count; };

${_arrays}
static const GenEnum kAll[] = {
${_registry}};
} // namespace

const std::unordered_map<std::string, long>& EnumTable(const std::string& name) {
    static const std::unordered_map<std::string, std::unordered_map<std::string, long>> kCache = [] {
        std::unordered_map<std::string, std::unordered_map<std::string, long>> c;
        for (const auto& e : kAll) {
            auto& m = c[e.name];
            for (int i = 0; i < e.count; ++i) m[e.items[i].name] = e.items[i].value;
        }
        return c;
    }();
    static const std::unordered_map<std::string, long> kEmpty;
    auto it = kCache.find(name);
    return it == kCache.end() ? kEmpty : it->second;
}
} // namespace CB::engine::common::enums
")

file(WRITE "${OUT_CPP}" "${_body}")
