# Default: normalize text to CRLF on this Windows-only project.
* text=auto eol=crlf

# The class schema is kept verbatim (no EOL normalization); its templates/ (Nemesis-ingest XML
# oracles) normalize like ordinary text.
schema/** -text
schema/templates/** text=auto eol=crlf

# Binary assets — never touch.
*.hkx  binary
*.hky  binary
*.bsa  binary
*.nif  binary
*.dds  binary
*.tri  binary
*.esp  binary
*.esm  binary
*.esl  binary

# Feature bundles (features/<Name>.hky/): a partition (a packed "*.hky" inside the folder) and any loose ".hkx"
# (a YAML compile target, an authored animation) are large and regenerated by tools, so they live in Git LFS,
# stored byte for byte. These lines must come after the binary block above: the later rule wins. The folder
# itself matches "*.hky" too, but a directory's match never reaches the files inside it, so manifest.json and the
# inject/ configs stay in git.
features/**/*.hkx filter=lfs diff=lfs merge=lfs -text
features/**/*.hky filter=lfs diff=lfs merge=lfs -text

src/engine/** -text
tools/hky/** -text
tools/cbdiff/** -text
