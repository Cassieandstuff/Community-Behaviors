# Default: normalize text to CRLF on this Windows-only project.
* text=auto eol=crlf

# The class schema is kept verbatim (no EOL normalization); its templates/ (Nemesis-ingest XML
# oracles) normalize like ordinary text.
schema/** -text
schema/templates/** text=auto eol=crlf

# Binary assets — never touch.
*.hkx  binary
*.hky  binary
*.bsa  binary
*.nif  binary
*.dds  binary
*.tri  binary
*.esp  binary
*.esm  binary
*.esl  binary

# Feature bundles (features/<Name>.hky/): each ".hkx" file is a YAML compile target (an authored animation),
# large and regenerated by tools, so it lives in Git LFS, stored byte for byte (no EOL normalization). This line
# must come after the binary block above: the later rule wins. manifest.json and other small files stay in git.
features/**/*.hkx filter=lfs diff=lfs merge=lfs -text

src/engine/** -text
tools/hky/** -text
tools/cbdiff/** -text
