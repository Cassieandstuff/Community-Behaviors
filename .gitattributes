# Default: normalize text to CRLF on this Windows-only project.
* text=auto eol=crlf

# The class schema is kept verbatim (no EOL normalization); its templates/ (Nemesis-ingest XML
# oracles) normalize like ordinary text.
schema/** -text
schema/templates/** text=auto eol=crlf

# Binary assets — never touch.
*.hkx  binary
*.hky  binary
*.bsa  binary
*.nif  binary
*.dds  binary
*.tri  binary
*.esp  binary
*.esm  binary
*.esl  binary

Havok/** -text
